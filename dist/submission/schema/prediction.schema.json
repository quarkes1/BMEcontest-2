{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event-stack prediction",
  "type": "object",
  "required": ["schema_version", "model", "input", "events", "diagnostics"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "model": {"type": "object", "required": ["name", "run_key"], "additionalProperties": false, "properties": {"name": {"const": "event-stack"}, "run_key": {"type": "string", "minLength": 1}}},
    "input": {"type": "object", "required": ["source", "duration_seconds"], "additionalProperties": false, "properties": {"source": {"type": "string"}, "duration_seconds": {"type": "number", "minimum": 0}}},
    "events": {"type": "array", "items": {"type": "object", "required": ["id", "session_id", "start_ms", "end_ms", "duration_s", "confidence"], "additionalProperties": false, "properties": {"id": {"type": "integer", "minimum": 0}, "session_id": {"type": "string", "minLength": 1}, "start_ms": {"type": "integer"}, "end_ms": {"type": "integer"}, "duration_s": {"type": "number", "exclusiveMinimum": 0}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}},
    "diagnostics": {"type": "object", "required": ["coverage", "warnings"], "additionalProperties": false, "properties": {"coverage": {"type": "number", "minimum": 0, "maximum": 1}, "warnings": {"type": "array", "items": {"type": "string"}}, "resolved_device": {"enum": ["cpu", "cuda"]}}},
    "timeline": {"type": "object", "required": ["session_ids", "macro_windows", "micro_windows"], "additionalProperties": false, "properties": {"session_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "macro_windows": {"type": "integer", "minimum": 0}, "micro_windows": {"type": "integer", "minimum": 0}, "series": {"type": "array", "items": {"type": "object", "required": ["session_id", "timestamp_ms", "macro_probability", "micro_probability", "valid", "gap"], "additionalProperties": false, "properties": {"session_id": {"type": "string", "minLength": 1}, "timestamp_ms": {"type": "integer"}, "macro_probability": {"type": "number", "minimum": 0, "maximum": 1}, "micro_probability": {"type": "number", "minimum": 0, "maximum": 1}, "valid": {"type": "boolean"}, "gap": {"type": "boolean"}}}}}},
    "candidates": {"type": "array", "items": {"type": "object", "required": ["session_id", "start_ms", "end_ms", "score", "admitted"], "additionalProperties": false, "properties": {"session_id": {"type": "string", "minLength": 1}, "start_ms": {"type": "integer"}, "end_ms": {"type": "integer"}, "score": {"type": "number", "minimum": 0, "maximum": 1}, "admitted": {"type": "boolean"}}}},
    "gaps": {"type": "array", "items": {"type": "object", "required": ["session_id", "start_ms", "end_ms"], "additionalProperties": false, "properties": {"session_id": {"type": "string", "minLength": 1}, "start_ms": {"type": "integer"}, "end_ms": {"type": "integer"}}}}
  }
}
