# 数据集与缓存目录只忽略仓库根下的实体；不做无锚定匹配，
# 否则 Windows 大小写不敏感会误伤 src/data、dist/submission/src/data 等。
/Archieves/
/Data/
*.7z
*.pyc
__pycache__/
/cache/
/cache/crossfit/
/models/
/FDdatasets/
/checkpoints/
outputs/*.log
outputs/*.txt
outputs/tmp/
outputs/experiments/
/outputs/crossfit/
/outputs/slide_cand_fold*.npz
/outputs/slide_diag_fold*.json
/.superpowers/
/.pytest_cache/
*.tmp
*.bak
*.staging-*/
*.backup-*/
.coverage
.mypy_cache/
.ruff_cache/

# 可视化前端（app/ 为开发目录；构建产物 index.html/assets/runtime 仍提交）
node_modules/
dist/visual/app/.vite/
dist/visual/app/coverage/

# 报告生成中间产物（截图与 matplotlib 图，可由 scripts/report/ 内脚本重建）
/scripts/report/assets/

# 提交包的本地压缩产物（打包用，不入库）
/dist/submission.zip
